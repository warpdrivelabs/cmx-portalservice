# cmx-portalservice 环境变量（run_portal() 启动时 dotenvy::dotenv() 从 cwd 读取）。
# 蓝本 = cmx-container/.env。差异：本 ws 在 presentation/cmx-portalservice/，凡指向 cmx-container
# 内资源的相对路径前缀 ../cmx-container/。

# Web 静态文件根目录（ConfigManager 读为 web_folder；init_web_config 必需）。
# 目录在 cmx-container 内 → ../cmx-container/ 前缀。
WEB_FOLDER="../cmx-container/crates/web/web-folder"

# 指定配置文件（本 ws 自带 portal-server.toml）
CONFIG_FILE="./portal-server.toml"

# panic 时打印详细调用栈
RUST_BACKTRACE=1

# 日志级别
RUST_LOG=info,cranelift_codegen=info,wasmtime_internal_cranelift=info,h2=info,tower=info,nacos_sdk=info

# ========== 注册中心/配置中心（新前缀解耦配置，默认禁用；Nacos 连接参数沿用 NACOS_*） ==========
# 类型预置 nacos——翻 ENABLED 开关即启用，与旧 NACOS_ENABLED 行为一致
SERVICE_REGISTRY_TYPE=nacos
SERVICE_REGISTRY_ENABLED=false
SERVICE_REGISTRY_NAME=cmx-portal-local
SERVICE_REGISTRY_GROUP=DEFAULT_GROUP
CONFIG_CENTER_TYPE=nacos
CONFIG_CENTER_ENABLED=false
# —— Nacos 连接配置（TYPE=nacos 时生效）——
NACOS_SERVER_ADDR=192.168.1.14:8848
NACOS_NAMESPACE=dev13
NACOS_APP_NAME=cmx-portalservice
NACOS_USERNAME=admin
NACOS_CONFIG_DATA_ID=dev_config.toml
NACOS_CONFIG_GROUP=DEFAULT_GROUP
